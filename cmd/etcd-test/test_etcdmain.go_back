package main

import (
	"context"
	clientv3 "go.etcd.io/etcd/client/v3"
	"go.uber.org/zap"
	"zingthings/pkg/util/etcd"
	"zingthings/pkg/util/loggerfactory"
)

func main() {
	ctx := context.Background()
	client := etcd.NewClient(ctx, loggerfactory.GetLogger())
	watchChan := client.Watch(ctx, "/test/key", clientv3.WithPrefix())
	for {
		select {
		case <-ctx.Done():
			return
		case resp := <-watchChan:
			for _, event := range resp.Events {
				switch event.Type {
				case clientv3.EventTypePut:
					loggerfactory.GetLogger().Info("put", zap.String("key", string(event.Kv.Key)), zap.String("value", string(event.Kv.Value)))
				case clientv3.EventTypeDelete:
					loggerfactory.GetLogger().Info("delete", zap.String("key", string(event.Kv.Key)))
				}
			}
		}
	}
}
