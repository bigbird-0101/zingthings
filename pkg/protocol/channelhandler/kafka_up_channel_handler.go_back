package channelhandler

import (
	"github.com/confluentinc/confluent-kafka-go/v2/kafka"
	"go.uber.org/zap"
	"os"
	"os/signal"
	"syscall"
	"zingthings/pkg/protocol/core"
)

type (
	KafkaUpChannelHandler struct {
		*core.SimplePredicateChannelHandler
		writer *kafka.Producer
		logger *zap.Logger
	}
)

func NewKafkaUpChannelHandler(logger *zap.Logger) *KafkaUpChannelHandler {
	named := logger.Named("KafkaUpChannelHandler")
	writer, err := kafka.NewProducer(&kafka.ConfigMap{"bootstrap.servers": "localhost"})
	if err != nil {
		panic(err)
	}
	var shutdownSignals = []os.Signal{os.Interrupt, syscall.SIGTERM}
	c := make(chan os.Signal, 1)
	signal.Notify(c, shutdownSignals...)
	go func() {
		<-c
		writer.Close()
	}()
	return &KafkaUpChannelHandler{
		writer: writer,
		logger: named,
		SimplePredicateChannelHandler: core.NewAsyncSimpleUpChannelHandler(
			func(handlerContext core.ChannelHandlerContext, message *core.Message) {
				logger.Info("start send kafka message ")
				topic := string("zthings." + message.Header.DeviceGroupId)
				err1 := writer.Produce(&kafka.Message{
					TopicPartition: kafka.TopicPartition{Topic: &topic, Partition: kafka.PartitionAny},
					Value:          message.Data.([]byte),
				}, nil)
				if err1 != nil {
					logger.Error("KafkaUpChannelHandler write up message error", zap.Error(err1))
					return
				}
				logger.Info("end send kafka message ")
			}),
	}
}
